{
    "name": "rtfirst/page-graph",
    "type": "typo3-cms-extension",
    "description": "Dashboard widget showing the TYPO3 page tree and content elements as an interactive force-directed graph visualization.",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "extension",
        "dashboard",
        "widget",
        "page tree",
        "graph",
        "visualization"
    ],
    "authors": [
        {
            "name": "Roland Tfirst",
            "email": "roland@tfirst.de"
        }
    ],
    "require": {
        "php": "^8.1",
        "typo3/cms-core": "^12.4 || ^13.0 || ^14.0",
        "typo3/cms-backend": "^12.4 || ^13.0 || ^14.0",
        "typo3/cms-dashboard": "^12.4 || ^13.0 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "RTfirst\\PageGraph\\": "Classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "rt_page_graph"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10 || ^2.0",
        "saschaegerer/phpstan-typo3": "^1.10 || ^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    }
}
